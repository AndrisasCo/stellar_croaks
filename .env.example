# Скопируйте этот файл в `.env` и подставьте реальные значения.
# `.env` в .gitignore и НЕ должен попадать в репозиторий.

# --- Клиент (Vite) ---------------------------------------------------------
# ВНИМАНИЕ: переменные VITE_* инлайнятся в бандл на этапе сборки и видны в браузере.
# Публичный ключ Supabase публичен по дизайну — доступ ограничивается политиками RLS,
# поэтому RLS на таблицах обязателен (готовый скрипт — supabase/schema.sql).
# Новый ключ проекта называется publishable (`sb_publishable_...`). Старое имя
# anon-ключа (`VITE_SUPABASE_ANON_KEY`) тоже поддерживается клиентом.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Автоматическое создание таблиц (npm run db:push) ---------------------
# Публичный ключ выше НЕ подходит для DDL: таблицы создаются через Management API.
# Personal Access Token: https://supabase.com/dashboard/account/tokens (начинается с sbp_).
# Это серверный секрет — он не должен попадать в клиентский код.
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token
# Обычно ref берётся из VITE_SUPABASE_URL автоматически. Укажите вручную, если URL
# нестандартный (кастомный домен и т.п.).
# SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
# Альтернатива PAT — строка подключения Postgres (нужен установленный psql):
# SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# --- Telegram-бот (bot.js, bot/notify.js; в бандл не попадают) -------------
# Токен берите у @BotFather. Это серверный секрет — не публикуйте его.
BOT_TOKEN=123456789:your-bot-token
# Адрес игры (обязательно https) для кнопки web_app: из бота это единственный
# вход в мини-апп, без него игрок не попадёт в игру.
APP_URL=https://your-game.example

# --- Service-role ключ (только сервер: бот и Edge Function) ----------------
# ВНИМАНИЕ: service-role ключ обходит RLS. В клиентском коде и в VITE_* ему места нет.
# Нужен боту (покупки за звёзды, уведомления) и функции telegram-auth.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Edge Function telegram-auth (задать в Supabase, не в .env) -------------
#   supabase secrets set BOT_TOKEN=... SUPABASE_SERVICE_ROLE_KEY=...
#   supabase functions deploy telegram-auth
# Подробности — supabase/README.md
