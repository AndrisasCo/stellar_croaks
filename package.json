{
  "name": "toad-pond",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "bot": "node --env-file-if-exists=.env bot.js",
    "notify": "node --env-file-if-exists=.env bot/notify.js",
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "vite preview",
    "optimize:images": "node scripts/optimize-images.mjs",
    "verify:init-data": "node tmp-verify-init-data.mjs",
    "verify:stars": "node tmp-verify-stars.mjs",
    "verify:platform": "node tmp-verify-platform.mjs",
    "verify": "npm run verify:init-data && npm run verify:stars && npm run verify:platform"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.81.0",
    "@tailwindcss/postcss": "^4.1.17",
    "pixi.js": "^8.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.34.5",
    "swr": "^2.3.6",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.0.0",
    "vite": "^4.4.0"
  }
}
