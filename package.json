{
  "name": "toad-pond",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "bot": "node --env-file-if-exists=.env bot.js",
    "bot:webhook:set": "node --env-file-if-exists=.env scripts/set-webhook.mjs",
    "bot:webhook:delete": "node --env-file-if-exists=.env scripts/set-webhook.mjs --delete",
    "bot:reset-keyboards": "node --env-file-if-exists=.env scripts/reset-keyboards.mjs",
    "notify": "node --env-file-if-exists=.env bot/notify.js",
    "dev": "vite --host",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "start": "vite preview",
    "start:bot": "npm run bot",
    "start:all": "node --env-file-if-exists=.env scripts/start-all.mjs",
    "db:push": "node --env-file-if-exists=.env scripts/db-push.mjs",
    "optimize:images": "node scripts/optimize-images.mjs",
    "verify:init-data": "node tmp-verify-init-data.mjs",
    "verify:stars": "node tmp-verify-stars.mjs",
    "verify:platform": "node tmp-verify-platform.mjs",
    "verify:colony": "node tmp-verify-colony-growth.mjs",
    "verify:crew": "node tmp-verify-expedition-crew.mjs",
    "verify:expedition-busy": "node tmp-verify-expedition-busy.mjs",
    "verify:expedition-aggression": "node tmp-verify-expedition-aggression.mjs",
    "verify:expedition-role-power": "node tmp-verify-expedition-role-power.mjs",
    "verify:expedition-offline": "node tmp-verify-expedition-offline.mjs",
    "verify:expedition-extract": "node tmp-verify-expedition-extract.mjs",
    "verify:expedition-evacuation": "node tmp-verify-expedition-evacuation.mjs",
    "verify:expedition-origin": "node tmp-verify-expedition-origin.mjs",
    "verify:assets": "node tmp-verify-assets.mjs",
    "verify:place": "node tmp-verify-toad-place.mjs",
    "verify:toad-move-menu": "node tmp-verify-toad-move-menu.mjs",
    "verify:names": "node tmp-verify-room-names.mjs",
    "verify:toad-picker": "node tmp-verify-toad-picker.mjs",
    "verify:biomass": "node tmp-verify-biomass-sell.mjs",
    "verify:gene-dust": "node tmp-verify-gene-dust.mjs",
    "verify:auth": "node tmp-verify-auth.mjs",
    "verify:boot": "node tmp-verify-boot.mjs",
    "verify:contour": "node tmp-verify-contour-pass.mjs",
    "verify:energy": "node tmp-verify-energy.mjs",
    "verify:tutorial-build": "node tmp-verify-tutorial-build.mjs",
    "verify:tutorial-flow": "node tmp-verify-tutorial-flow.mjs",
    "verify:bot-keyboard": "node tmp-verify-bot-keyboard.mjs",
    "verify:quest-journal": "node tmp-verify-quest-journal.mjs",
    "verify": "npm run verify:init-data && npm run verify:stars && npm run verify:platform && npm run verify:colony && npm run verify:crew && npm run verify:expedition-busy && npm run verify:expedition-aggression && npm run verify:expedition-role-power && npm run verify:expedition-offline && npm run verify:expedition-extract && npm run verify:expedition-evacuation && npm run verify:expedition-origin && npm run verify:assets && npm run verify:place && npm run verify:toad-move-menu && npm run verify:names && npm run verify:toad-picker && npm run verify:biomass && npm run verify:gene-dust && npm run verify:auth && npm run verify:boot && npm run verify:contour && npm run verify:energy && npm run verify:tutorial-build && npm run verify:tutorial-flow && npm run verify:bot-keyboard && npm run verify:quest-journal",
    "bot:check": "node --env-file-if-exists=.env scripts/check-bot-token.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.81.0",
    "@tailwindcss/postcss": "^4.1.17",
    "pixi.js": "^8.14.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sharp": "^0.34.5",
    "swr": "^2.3.6",
    "telegraf": "^4.16.3"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.1.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.0.0",
    "vite": "^4.4.0"
  }
}
